@tailwind base;
@tailwind components;
@tailwind utilities;

/* JSN Solver — SaaS PWA theme (neutral, professional) */

@layer base {
  :root {
    /* Core neutral surfaces */
    --background: 220 14% 9%;
    --foreground: 210 20% 98%;

    --card: 220 14% 12%;
    --card-foreground: 210 20% 98%;

    --popover: 220 14% 12%;
    --popover-foreground: 210 20% 98%;

    /* Primary — calm slate-blue, no neon */
    --primary: 217 91% 60%;
    --primary-foreground: 0 0% 100%;

    /* Secondary — surface panel */
    --secondary: 220 14% 16%;
    --secondary-foreground: 210 20% 98%;

    --muted: 220 14% 22%;
    --muted-foreground: 215 16% 65%;

    /* Accent — same family, slightly desaturated */
    --accent: 217 91% 60%;
    --accent-foreground: 0 0% 100%;

    --destructive: 0 72% 55%;
    --destructive-foreground: 0 0% 100%;

    --border: 220 14% 20%;
    --input: 220 14% 20%;
    --ring: 217 91% 60%;

    --radius: 0.875rem;

    /* Cube face colors */
    --cube-white: 0 0% 95%;
    --cube-yellow: 48 100% 50%;
    --cube-red: 0 85% 50%;
    --cube-orange: 30 100% 50%;
    --cube-blue: 220 100% 50%;
    --cube-green: 140 80% 45%;

    /* Muted accent tokens (kept for legacy refs) */
    --gold: 45 90% 55%;
    --cyan: 187 70% 50%;
    --purple: 258 60% 60%;
    --magenta: 292 60% 55%;

    --sidebar-background: 220 14% 11%;
    --sidebar-foreground: 210 20% 98%;
    --sidebar-primary: 217 91% 60%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 217 91% 60%;
    --sidebar-accent-foreground: 0 0% 100%;
    --sidebar-border: 220 14% 20%;
    --sidebar-ring: 217 91% 60%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  
  body {
    @apply bg-background text-foreground antialiased;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  
  /* Scrollbar styling */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  
  ::-webkit-scrollbar-track {
    @apply bg-transparent;
  }
  
  ::-webkit-scrollbar-thumb {
    @apply bg-muted rounded-full;
  }
}

@layer components {
  /* Glass card with subtle border */
  .glass-card {
    @apply rounded-2xl p-4;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
  }
  
  /* Stat card - like MOVES/TIME/BEST TIME displays */
  .stat-card {
    @apply glass-card;
  }
  
  .stat-card-label {
    @apply text-xs font-semibold tracking-wider uppercase text-muted-foreground mb-1;
  }
  
  .stat-card-value {
    @apply text-2xl font-bold text-foreground tabular-nums;
  }
  
  /* Primary button — flat solid (SaaS) */
  .btn-primary {
    @apply relative rounded-xl px-6 py-3 font-semibold text-primary-foreground transition-colors duration-150;
    background: hsl(var(--primary));
  }

  .btn-primary:hover {
    background: hsl(217 91% 55%);
  }

  .btn-primary:active {
    background: hsl(217 91% 50%);
  }

  .btn-primary:disabled {
    @apply opacity-50 cursor-not-allowed;
  }
  
  /* Secondary button - Dark with border */
  .btn-secondary {
    @apply rounded-xl px-6 py-3 font-semibold transition-all duration-200;
    background: hsl(var(--secondary));
    border: 1px solid hsl(var(--border));
  }
  
  .btn-secondary:hover {
    background: hsl(var(--muted));
  }
  
  /* Icon button - Circular */
  .btn-icon {
    @apply p-3 rounded-full transition-colors;
    background: hsl(var(--secondary));
  }
  
  .btn-icon:hover {
    background: hsl(var(--muted));
  }
  
  /* Bottom navigation */
  .bottom-nav {
    @apply fixed bottom-0 left-0 right-0 z-40;
    background: hsl(var(--card) / 0.95);
    backdrop-filter: blur(20px);
    border-top: 1px solid hsl(var(--border));
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  
  .bottom-nav-item {
    @apply flex flex-col items-center justify-center gap-1 py-3 px-4 transition-colors;
  }
  
  .bottom-nav-item.active {
    @apply text-primary;
  }
  
  .bottom-nav-item:not(.active) {
    @apply text-muted-foreground;
  }
  
  /* Cube sticker styling */
  .cube-sticker {
    @apply rounded-lg transition-all duration-200 cursor-pointer;
    box-shadow: inset 0 2px 4px hsl(0 0% 100% / 0.15), 0 2px 4px hsl(0 0% 0% / 0.3);
  }
  
  .cube-sticker:hover {
    transform: scale(1.05);
  }
  
  /* Face scanning grid */
  .scan-grid {
    @apply grid grid-cols-3 gap-2;
  }
  
  .scan-cell {
    @apply aspect-square rounded-xl border-2 transition-all;
    border-color: hsl(var(--primary));
    background: hsl(var(--secondary) / 0.5);
  }
  
  .scan-cell.filled {
    border-color: transparent;
  }
  
  /* Level node on map */
  .level-node {
    @apply w-16 h-16 rounded-2xl flex items-center justify-center font-bold text-xl transition-all;
    background: hsl(var(--secondary));
    border: 2px solid hsl(var(--primary) / 0.3);
  }
  
  .level-node.current {
    border-color: hsl(var(--primary));
    box-shadow: 0 0 20px hsl(var(--primary) / 0.5);
  }
  
  .level-node.locked {
    @apply opacity-50;
  }
  
  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* Rainbow progress bar segments */
  .rainbow-progress {
    @apply h-2 rounded-full overflow-hidden flex;
  }
  
  .rainbow-progress .segment {
    @apply h-full transition-all duration-300;
  }
}

@layer utilities {
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  
  .animate-pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }
  
  .animate-spin-slow {
    animation: spin 20s linear infinite;
  }
  
  /* Hide scrollbar but keep functionality */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Safe area padding for mobile */
  .safe-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  
  .safe-top {
    padding-top: env(safe-area-inset-top, 0);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(2deg); }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px hsl(var(--primary) / 0.3); }
  50% { box-shadow: 0 0 40px hsl(var(--primary) / 0.5); }
}
