@tailwind base;
@tailwind components;
@tailwind utilities;

/* JSN Solver — Neon Arcade theme */

@layer base {
  :root {
    /* Core surfaces — near-black, slightly blue-tinted */
    --background: 230 22% 15%;
    --foreground: 210 20% 98%;

    --card: 230 22% 20%;
    --card-foreground: 210 20% 98%;

    --popover: 230 22% 20%;
    --popover-foreground: 210 20% 98%;

    /* Primary — electric cyan */
    --primary: 120 65% 45%;
    --primary-foreground: 230 30% 6%;

    /* Secondary — dark panel with a hint of the primary hue */
    --secondary: 232 20% 24%;
    --secondary-foreground: 210 20% 98%;

    --muted: 232 18% 30%;
    --muted-foreground: 220 15% 75%;

    /* Accent — neon magenta, used for contrast highlights */
    --accent: 300 90% 62%;
    --accent-foreground: 0 0% 100%;

    --destructive: 0 85% 60%;
    --destructive-foreground: 0 0% 100%;

    --border: 232 20% 30%;
    --input: 232 20% 30%;
    --ring: 120 65% 45%;

    --radius: 0.875rem;

    /* Cube face colors — kept true-to-life so the cube stays recognizable */
    --cube-white: 0 0% 95%;
    --cube-yellow: 48 100% 50%;
    --cube-red: 0 85% 50%;
    --cube-orange: 30 100% 50%;
    --cube-blue: 220 100% 50%;
    --cube-green: 140 80% 45%;

    /* Neon accent tokens */
    --gold: 45 95% 58%;
    --cyan: 189 100% 55%;
    --purple: 265 85% 65%;
    --magenta: 300 90% 62%;

    --sidebar-background: 230 22% 17%;
    --sidebar-foreground: 210 20% 98%;
    --sidebar-primary: 120 65% 45%;
    --sidebar-primary-foreground: 230 30% 6%;
    --sidebar-accent: 300 90% 62%;
    --sidebar-accent-foreground: 0 0% 100%;
    --sidebar-border: 232 20% 30%;
    --sidebar-ring: 120 65% 45%;
  }
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -10%, hsl(var(--primary) / 0.12), transparent),
      radial-gradient(ellipse 60% 40% at 100% 100%, hsl(var(--accent) / 0.08), transparent);
    background-attachment: fixed;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    @apply bg-transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--primary) / 0.4);
    border-radius: 999px;
  }
}

@layer components {
  /* Glass card with neon-tinted border + subtle inner glow */
  .glass-card {
    @apply rounded-2xl p-4;
    background: hsl(var(--card) / 0.85);
    border: 1px solid hsl(var(--border));
    backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px hsl(var(--primary) / 0.05), 0 8px 24px hsl(0 0% 0% / 0.35);
  }

  .stat-card {
    @apply glass-card;
  }

  .stat-card-label {
    @apply text-xs font-semibold tracking-wider uppercase text-muted-foreground mb-1;
  }

  .stat-card-value {
    @apply text-2xl font-bold text-foreground tabular-nums;
    text-shadow: 0 0 12px hsl(var(--primary) / 0.35);
  }

  /* Primary button — glowing neon fill */
  .btn-primary {
    @apply relative rounded-xl px-6 py-3 font-semibold text-primary-foreground transition-all duration-150;
    background: hsl(var(--primary));
    box-shadow: 0 0 16px hsl(var(--primary) / 0.45), 0 0 2px hsl(var(--primary) / 0.6);
  }

  .btn-primary:hover {
    background: hsl(189 100% 62%);
    box-shadow: 0 0 26px hsl(var(--primary) / 0.65), 0 0 4px hsl(var(--primary) / 0.8);
  }

  .btn-primary:active {
    background: hsl(189 100% 48%);
  }

  .btn-primary:disabled {
    @apply opacity-40 cursor-not-allowed;
    box-shadow: none;
  }

  /* Secondary button — dark with neon-hairline border */
  .btn-secondary {
    @apply rounded-xl px-6 py-3 font-semibold transition-all duration-200;
    background: hsl(var(--secondary));
    border: 1px solid hsl(var(--border));
  }

  .btn-secondary:hover {
    background: hsl(var(--muted));
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: 0 0 12px hsl(var(--primary) / 0.2);
  }

  /* Icon button */
  .btn-icon {
    @apply p-3 rounded-full transition-all;
    background: hsl(var(--secondary));
  }

  .btn-icon:hover {
    background: hsl(var(--muted));
    box-shadow: 0 0 10px hsl(var(--primary) / 0.35);
  }

  /* Bottom navigation — glowing top hairline */
  .bottom-nav {
    @apply fixed bottom-0 left-0 right-0 z-40;
    background: hsl(var(--card) / 0.9);
    backdrop-filter: blur(20px);
    border-top: 1px solid hsl(var(--primary) / 0.25);
    box-shadow: 0 -4px 20px hsl(0 0% 0% / 0.4);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .bottom-nav-item {
    @apply flex flex-col items-center justify-center gap-1 py-3 px-4 transition-colors;
  }

  .bottom-nav-item.active {
    @apply text-primary;
    filter: drop-shadow(0 0 6px hsl(var(--primary) / 0.7));
  }

  .bottom-nav-item:not(.active) {
    @apply text-muted-foreground;
  }

  /* Cube sticker styling */
  .cube-sticker {
    @apply rounded-lg transition-all duration-200 cursor-pointer;
    box-shadow: inset 0 2px 4px hsl(0 0% 100% / 0.15), 0 2px 4px hsl(0 0% 0% / 0.3);
  }

  .cube-sticker:hover {
    transform: scale(1.05);
  }

  /* Face scanning grid */
  .scan-grid {
    @apply grid grid-cols-3 gap-2;
  }

  .scan-cell {
    @apply aspect-square rounded-xl border-2 transition-all;
    border-color: hsl(var(--primary));
    background: hsl(var(--secondary) / 0.5);
  }

  .scan-cell.filled {
    border-color: transparent;
  }

  /* Level node on map */
  .level-node {
    @apply w-16 h-16 rounded-2xl flex items-center justify-center font-bold text-xl transition-all;
    background: hsl(var(--secondary));
    border: 2px solid hsl(var(--primary) / 0.3);
  }

  .level-node.current {
    border-color: hsl(var(--primary));
    box-shadow: 0 0 24px hsl(var(--primary) / 0.6);
  }

  .level-node.locked {
    @apply opacity-50;
  }

  /* Gradient text — neon cyan to magenta */
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Rainbow progress bar segments */
  .rainbow-progress {
    @apply h-2 rounded-full overflow-hidden flex;
  }

  .rainbow-progress .segment {
    @apply h-full transition-all duration-300;
  }
}

@layer utilities {
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .animate-spin-slow {
    animation: spin 20s linear infinite;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .safe-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .safe-top {
    padding-top: env(safe-area-inset-top, 0);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(2deg); }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px hsl(var(--primary) / 0.35); }
  50% { box-shadow: 0 0 40px hsl(var(--primary) / 0.6); }
}
