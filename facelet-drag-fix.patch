From: JSN Dev <dev@jsn-solver.app>
Date: Thu, 20 Aug 2026 15:04:50 +0000
Subject: [PATCH] fix: add missing projectAxisScreenDir +
 stopImmediatePropagation for mobile facelet drag

---
 src/components/CubeRenderer3D.tsx | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/components/CubeRenderer3D.tsx b/src/components/CubeRenderer3D.tsx
index b2138ca..3f29b7f 100644
--- a/src/components/CubeRenderer3D.tsx
+++ b/src/components/CubeRenderer3D.tsx
@@ -197,6 +197,25 @@ interface SceneProps {
   apiRef: React.MutableRefObject<CameraApiRef | null>;
 }
 
+function projectAxisScreenDir(
+  p0: THREE.Vector3,
+  dirWorld: THREE.Vector3,
+  camera: THREE.Camera,
+  rect: DOMRect,
+): { x: number; y: number } {
+  const p1 = p0.clone().addScaledVector(dirWorld, 0.4);
+  const toScreen = (p: THREE.Vector3) => {
+    const v = p.clone().project(camera);
+    return {
+      x: rect.left + (v.x * 0.5 + 0.5) * rect.width,
+      y: rect.top + (1 - (v.y * 0.5 + 0.5)) * rect.height,
+    };
+  };
+  const s0 = toScreen(p0);
+  const s1 = toScreen(p1);
+  return { x: s1.x - s0.x, y: s1.y - s0.y };
+}
+
 const CubeSceneInner = ({ cubies, animFrameRef, interactive, autoRotateIdle, inputsOn, apiRef }: SceneProps) => {
   const cubeRootRef = useRef<THREE.Group>(null);
   const controlsRef = useRef<any>(null);
@@ -258,6 +277,8 @@ const CubeSceneInner = ({ cubies, animFrameRef, interactive, autoRotateIdle, inp
       if (!inputsOn || isAnimating || dragRef.current) return;
       if (e.button !== 0) return; // Only trigger for left-clicks/primary touch
       e.stopPropagation();
+      // Prevent OrbitControls from seeing this touch on mobile
+      (e as any).nativeEvent?.stopImmediatePropagation?.();
 
       // Temporarily disable OrbitControls to prevent camera rotation during face drag
       if (controlsRef.current) {
